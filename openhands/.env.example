# OpenHands image/version
OPENHANDS_VERSION=1.8

# OpenHands app data and workspace mounts
OPENHANDS_STATE_DIR=./openhands-state
WORKSPACE_DIR=./workspace

# Agent server image used by the app to create sandboxes
AGENT_SERVER_IMAGE_REPOSITORY=ghcr.io/openhands/agent-server
AGENT_SERVER_IMAGE_TAG=1.26.0-python

# Traefik / public routing
OPENHANDS_DOMAIN=openhands.example.com
